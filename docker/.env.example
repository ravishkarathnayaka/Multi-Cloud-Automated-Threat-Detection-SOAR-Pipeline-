# ==============================================================================
# Multi-Cloud Threat Detection & SOAR Pipeline - Environment Configuration
# ==============================================================================

# AWS / LocalStack Region
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# LocalStack Configuration
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
# Optional LocalStack Pro Auth Token (unneeded for standard community features)
LOCALSTACK_AUTH_TOKEN=

# OpenSearch SIEM Settings
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_DASHBOARDS_PORT=5601

# Alert Webhook Settings (Points to local mock receiver by default)
# For live Slack notifications, replace with: https://hooks.slack.com/services/T00/B00/X00
ALERT_WEBHOOK_URL=http://localhost:8080/webhook

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Deployment Environment (dev, staging, prod)
ENVIRONMENT=dev
